# Maintainer: Carlos Vinicius <https://github.com/ViniciusDev26>
#
# Built from the release tag's source. pkgver and sha256sums are updated by CI
# (.github/workflows/release.yml).
pkgname=rustpaper
pkgver=0.11.0 # x-release-please-version
pkgrel=1
pkgdesc="Wallpaper Engine wallpapers on Wayland: the real WE under Proton, mirrored onto the desktop (+ selector)"
arch=('x86_64')
url="https://github.com/sugomi-dev/Rustpaper"
license=('MIT')
depends=('gcc-libs' 'glibc' 'gtk3' 'libglvnd' 'libxkbcommon' 'wayland' 'webkit2gtk-4.1'
         'mesa' 'util-linux' 'xorg-xwayland' 'steam' 'pam' 'dbus')
optdepends=('mpv: plays video wallpapers with hardware decoding instead of Wallpaper Engine'
            'libpulse: pactl, for the volume and mute of Wallpaper Engine (PipeWire or PulseAudio)')
backup=('etc/pam.d/rustpaper-lock')
# rustup, not the plain rust package: rustpaper-we-helper.exe is built for
# the x86_64-pc-windows-msvc target, whose standard library only rustup has
makedepends=('rustup' 'pkgconf' 'nodejs' 'npm')
conflicts=('rustpaper-bin')
source=("$pkgname-$pkgver.tar.gz::https://github.com/sugomi-dev/Rustpaper/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!lto')

prepare() {
    cd "Rustpaper-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    rustup toolchain install stable --profile minimal --target x86_64-pc-windows-msvc
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
    # the selector's React UI: its build.rs runs `npm run build` offline
    (cd crates/rustpaper-selector/ui && npm ci --no-audit --no-fund)
}

build() {
    cd "Rustpaper-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release \
        -p rustpaper-engine -p rustpaper-selector -p rustpaper-workshop --bins
    # run by the engine inside Wallpaper Engine's Proton (no dependencies)
    cargo build --frozen --release -p rustpaper-we-helper --target x86_64-pc-windows-msvc
}

package() {
    cd "Rustpaper-$pkgver"
    for b in rustpaper rustpaper-selector rustpaper-workshop; do
        install -Dm755 "target/release/$b" "$pkgdir/usr/bin/$b"
    done
    # Steamworks client library (bundled by steamworks-sys, copied by the
    # workshop crate's build.rs) for rustpaper-workshop: RUNPATH ../lib/rustpaper
    install -Dm755 target/release/libsteam_api.so "$pkgdir/usr/lib/rustpaper/libsteam_api.so"
    install -Dm644 target/x86_64-pc-windows-msvc/release/rustpaper-we-helper.exe \
        "$pkgdir/usr/lib/rustpaper/rustpaper-we-helper.exe"
    install -Dm644 packaging/rustpaper.desktop "$pkgdir/usr/share/applications/rustpaper.desktop"
    install -Dm644 crates/rustpaper-selector/icons/128x128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/rustpaper.png"
    # the lock screen's PAM service
    install -Dm644 packaging/pam/rustpaper-lock "$pkgdir/etc/pam.d/rustpaper-lock"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
